ANTHROPIC_API_KEY=
# Optional: override default model (claude-sonnet-4-6)
ANTHROPIC_MODEL=

# Vercel Postgres / Supabase などのPostgres接続文字列
DATABASE_URL=

# X (旧Twitter) Developer Portal で発行するOAuth 1.0aの認証情報
# 自分のアカウントとして投稿するための Access Token/Secret も必要
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# /api/cron/post-daily を保護するための任意の文字列
# Vercelの環境変数に設定すると、Vercel Cronからのリクエストに自動で
# Authorization: Bearer <この値> が付与される
CRON_SECRET=

# マラソンコース シミュレーター(/marathon)用のGoogle Maps APIキー
# Google Cloud ConsoleでMaps JavaScript API と Street View Static API を有効化し、
# HTTPリファラーでドメインを制限してください(ブラウザから直接呼ぶため NEXT_PUBLIC_ が必要)
# 未設定でもページ上でキーを一時入力すれば動作確認できます
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
