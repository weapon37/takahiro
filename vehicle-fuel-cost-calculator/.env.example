# サービスアカウントの鍵ファイル(JSON)のパス
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# 対象のスプレッドシートID (URLの /d/ と /edit の間の文字列)
SPREADSHEET_ID=

# ガソリン代按分シートのシート名 (省略時は「ガソリン代按分」)
FUEL_SHEET_NAME=ガソリン代按分

# ocr_driving_log.py で運行表の画像を読み取るために使用 (https://console.anthropic.com/ で発行)
ANTHROPIC_API_KEY=

# 省略時は claude-sonnet-5 を使用
# ANTHROPIC_MODEL=claude-sonnet-5

# config.json を使う場合、参照するファイルパスを変更したいときのみ指定
# (省略時はカレントディレクトリの ./config.json を自動参照)
# CONFIG_FILE=./config.json
